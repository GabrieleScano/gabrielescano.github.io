---
/**
 * "Let's talk": a button that expands in place into a row of contact options
 * (email, copy the address for people on webmail, LinkedIn, GitHub) instead
 * of opening a floating menu over the hero. The × (or Escape) collapses it
 * back and returns focus to the button. The open row is exactly as tall as
 * the button (42px), so nothing around it moves.
 */
import { getLang, useTranslations } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const email = 'gabrielescano.bcn@gmail.com';
const id = `contact-options-${Math.random().toString(36).slice(2, 8)}`;

const chip =
  'inline-flex items-center gap-1.5 rounded-full px-2.5 py-1.5 text-sm sm:gap-2 sm:px-3.5 text-ink transition-colors hover:bg-accent-soft focus-visible:bg-accent-soft';
const icon = 'h-4 w-4 shrink-0 text-muted';
---

<div
  class="contact-menu"
  data-contact-menu
  data-copy-label={t('contact.email.copy')}
  data-copied-label={t('contact.email.copied')}
>
  <button
    type="button"
    aria-expanded="false"
    aria-controls={id}
    data-contact-trigger
    class="rounded-full border border-line bg-surface px-6 py-2.5 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent"
  >
    {t('contact.cta')}
  </button>

  <div
    id={id}
    role="group"
    aria-label={t('contact.cta')}
    hidden
    data-contact-panel
    class="contact-row flex flex-wrap items-center gap-0.5 rounded-3xl border border-accent bg-surface p-1"
  >
    <a href={`mailto:${email}`} class={chip}>
      <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path>
      </svg>
      {t('contact.email.write')}
    </a>
    <button type="button" class={chip} data-contact-copy={email}>
      <svg class={icon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
      </svg>
      <span data-contact-copy-label>{t('contact.email.copy')}</span>
      <span class="sr-only">{t('contact.email.copy.sr')}</span>
    </button>
    <a href="https://linkedin.com/in/gabrielescano" target="_blank" rel="me noopener" class={chip}>
      <svg class={icon} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M13.02 13.02h-2.4v-3.76c0-.9-.02-2.05-1.25-2.05-1.25 0-1.44.98-1.44 1.99v3.82H5.53V5.98h2.3v.99h.03c.32-.6 1.1-1.24 2.27-1.24 2.43 0 2.88 1.6 2.88 3.68v3.61ZM3.56 4.98a1.39 1.39 0 1 1 0-2.78 1.39 1.39 0 0 1 0 2.78ZM4.76 13.02H2.35V5.98h2.4v7.04Z"></path>
      </svg>
      <span class="max-sm:sr-only">LinkedIn</span>
    </a>
    <a href="https://github.com/GabrieleScano" target="_blank" rel="me noopener" class={chip}>
      <svg class={icon} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
      </svg>
      <span class="max-sm:sr-only">GitHub</span>
    </a>
    <button
      type="button"
      data-contact-close
      aria-label={t('contact.close')}
      class="grid h-8 w-8 place-items-center rounded-full text-muted transition-colors hover:bg-accent-soft hover:text-ink focus-visible:bg-accent-soft"
    >
      <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 4l8 8M12 4l-8 8"></path>
      </svg>
    </button>
    <p class="sr-only" aria-live="polite" data-contact-status></p>
  </div>
</div>

<style>
  .contact-row:not([hidden]) {
    animation: contact-reveal 0.28s ease both;
  }
  @keyframes contact-reveal {
    from {
      opacity: 0;
      clip-path: inset(0 100% 0 0 round 1.5rem);
    }
    to {
      opacity: 1;
      clip-path: inset(0 0 0 0 round 1.5rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-row:not([hidden]) {
      animation: none;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-contact-menu]')) {
    const trigger = root.querySelector<HTMLButtonElement>('[data-contact-trigger]')!;
    const panel = root.querySelector<HTMLElement>('[data-contact-panel]')!;
    const status = root.querySelector<HTMLElement>('[data-contact-status]')!;
    const { copyLabel = '', copiedLabel = '' } = root.dataset;

    const open = () => {
      trigger.hidden = true;
      trigger.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
      panel.querySelector<HTMLElement>('a, button')?.focus();
    };
    const close = () => {
      panel.hidden = true;
      trigger.hidden = false;
      trigger.setAttribute('aria-expanded', 'false');
      trigger.focus();
    };

    trigger.addEventListener('click', open);
    root.querySelector('[data-contact-close]')!.addEventListener('click', close);
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) close();
    });

    const copyBtn = root.querySelector<HTMLButtonElement>('[data-contact-copy]');
    const label = root.querySelector<HTMLElement>('[data-contact-copy-label]')!;
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.contactCopy!);
      } catch {
        // Clipboard blocked (e.g. insecure context): fall back to mailto.
        location.href = `mailto:${copyBtn.dataset.contactCopy}`;
        return;
      }
      label.textContent = copiedLabel;
      status.textContent = copiedLabel;
      setTimeout(() => {
        label.textContent = copyLabel;
        status.textContent = '';
      }, 2000);
    });
  }
</script>
