---
import { getLang, useTranslations, localeBase } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const base = localeBase(lang);
---

<div
  id="cookie-banner"
  hidden
  role="region"
  aria-label={t('cookie.aria')}
  class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-bg/95 backdrop-blur supports-[backdrop-filter]:bg-bg/90"
>
  <div
    class="mx-auto flex max-w-5xl flex-col gap-4 px-[var(--spacing-gutter)] py-5 sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="text-sm text-muted">
      {t('cookie.text')}
      <a
        href={`${base}/privacy`}
        class="text-accent underline underline-offset-2 hover:text-accent-strong"
      >
        {t('cookie.link')}
      </a>.
    </p>
    <div class="flex shrink-0 items-center gap-3">
      <button
        id="cookie-reject"
        type="button"
        class="rounded-full border border-line px-4 py-1.5 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent"
      >
        {t('cookie.reject')}
      </button>
      <button
        id="cookie-accept"
        type="button"
        class="rounded-full bg-accent px-4 py-1.5 text-sm font-medium text-accent-ink transition-colors hover:bg-accent-strong"
      >
        {t('cookie.accept')}
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const KEY = 'cookie-consent';
    const banner = document.getElementById('cookie-banner');
    const acceptBtn = document.getElementById('cookie-accept');
    const rejectBtn = document.getElementById('cookie-reject');

    const readStored = () => {
      try {
        return localStorage.getItem(KEY);
      } catch (e) {
        return null;
      }
    };

    const store = (value) => {
      try {
        localStorage.setItem(KEY, value);
      } catch (e) {}
    };

    const applyConsent = (value) => {
      if (value === 'accepted') {
        window.__gaGrantConsent?.();
        return;
      }
      window.gtag?.('consent', 'update', { analytics_storage: 'denied' });
    };

    const show = () => banner?.removeAttribute('hidden');
    const hide = () => banner?.setAttribute('hidden', '');

    if (!readStored()) show();

    acceptBtn?.addEventListener('click', () => {
      store('accepted');
      applyConsent('accepted');
      hide();
    });

    rejectBtn?.addEventListener('click', () => {
      store('rejected');
      applyConsent('rejected');
      hide();
    });

    // The footer "Cookie preferences" link reopens the banner so visitors
    // can change their mind at any time.
    document.addEventListener('click', (e) => {
      const target =
        e.target instanceof Element ? e.target.closest('#cookie-preferences-link') : null;
      if (!target) return;
      e.preventDefault();
      show();
    });
  })();
</script>
