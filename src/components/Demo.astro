---
import { getLang, useTranslations } from '../i18n/utils';
import { analyze } from '../lib/reqcheck/analyze';
import { demoCopy, toneFor, tint, SEVERITY_COLOR, FINDING_CLASSES as C } from './demoPresentation';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

// Initial (flawed) example, shown server-rendered so the form is populated
// before the island hydrates. The rule engine only understands English, so
// the example text and its findings stay in English in both locales.
const initialStory =
  'As a shopper, I want to search for products so that I can find what I need.';
const initialCriteria = [
  'The search should be fast and return relevant results.',
  'When I type a query, then matching products are shown.',
  'Results should handle a large number of products efficiently.',
].join('\n');

// Analyse it at build time too, so the results arrive in the HTML instead of
// popping in (and the meter animating from 0) once the script runs.
const initial = analyze(initialStory, initialCriteria);
const copy = demoCopy(lang);
const tone = toneFor(initial.clarityScore, lang);
---

<section class="grid gap-8 lg:grid-cols-2">
  <!-- Input -->
  <form id="reqcheck-form" class="flex flex-col gap-5" novalidate>
    <div>
      <span class="font-mono text-xs uppercase tracking-widest text-muted">
        {t('demo.widget.tryExample')}
      </span>
      <div class="mt-2 flex flex-wrap gap-2">
        <button type="button" data-example="flawed" class="demo-chip">{t('demo.widget.flawed')}</button>
        <button type="button" data-example="clean" class="demo-chip">{t('demo.widget.clean')}</button>
        <button type="button" data-example="clear" class="demo-chip">{t('demo.widget.clear')}</button>
      </div>
    </div>

    <div>
      <label for="story" class="block text-sm font-medium text-ink">{t('demo.widget.userStory')}</label>
      <textarea
        id="story"
        rows="3"
        class="demo-field"
        placeholder="As a …, I want …, so that …"
        spellcheck="false">{initialStory}</textarea>
    </div>

    <div>
      <label for="criteria" class="block text-sm font-medium text-ink">
        {t('demo.widget.criteria')} <span class="text-muted">{t('demo.widget.criteriaHint')}</span>
      </label>
      <textarea
        id="criteria"
        rows="8"
        class="demo-field font-mono text-sm"
        spellcheck="false">{initialCriteria}</textarea>
    </div>

    <p class="text-xs text-muted">
      {t('demo.widget.runsInBrowser')}
    </p>
  </form>

  <!-- Results -->
  <div
    id="reqcheck-results"
    class="rounded-2xl border border-line bg-surface p-6 sm:p-8"
    aria-live="polite"
  >
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-muted">
          {t('demo.widget.clarityScore')}
        </p>
        <p class="mt-1 font-display text-5xl font-semibold tracking-tight">
          <span id="reqcheck-score" style={`color: ${tone.color}`}>{initial.clarityScore}</span>
          <span class="text-2xl text-muted">/100</span>
        </p>
      </div>
      <span
        id="reqcheck-score-label"
        class="rounded-full px-3 py-1 font-mono text-xs"
        style={`color: ${tone.color}; background: ${tint(tone.color)}`}
      >{tone.label}</span>
    </div>

    <div class="mt-4 h-2 overflow-hidden rounded-full bg-line">
      <div
        id="reqcheck-meter"
        class="h-full rounded-full transition-[width,background-color] duration-500"
        style={`width: ${initial.clarityScore}%; background-color: ${tone.color}`}
      >
      </div>
    </div>

    <p id="reqcheck-summary" class="mt-6 font-mono text-sm text-muted">
      {initial.findings.length ? copy.findings(initial.findings.length) : copy.noIssues}
    </p>
    <ul id="reqcheck-findings" class="mt-4 space-y-3">
      {
        initial.findings.map((f) => (
          <li class={C.item}>
            <span
              class={C.pill}
              style={`color: ${SEVERITY_COLOR[f.severity]}; background: ${tint(SEVERITY_COLOR[f.severity])}`}
            >
              {copy.severity[f.severity]}
            </span>
            <div class={C.body}>
              <p class={C.category}>{f.category}</p>
              <p class={C.message}>{f.message}</p>
              {f.criterion && <p class={C.criterion}>"{f.criterion}"</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .demo-chip {
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    padding: 0.375rem 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    transition: all 0.15s ease;
  }
  .demo-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .demo-field {
    margin-top: 0.5rem;
    width: 100%;
    border-radius: 0.75rem;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 0.75rem 0.875rem;
    color: var(--color-ink);
    line-height: 1.5;
    resize: vertical;
  }
  .demo-field:focus-visible {
    border-color: var(--color-accent);
    outline: none;
    box-shadow: 0 0 0 3px var(--color-accent-soft);
  }
</style>

<script>
  import { analyze } from '../lib/reqcheck/analyze';
  import type { Finding } from '../lib/reqcheck/types';
  import { demoCopy, toneFor, tint, SEVERITY_COLOR, FINDING_CLASSES as C } from './demoPresentation';

  const EXAMPLES: Record<'flawed' | 'clean', { story: string; criteria: string }> = {
    flawed: {
      story: 'As a shopper, I want to search for products so that I can find what I need.',
      criteria: [
        'The search should be fast and return relevant results.',
        'When I type a query, then matching products are shown.',
        'Results should handle a large number of products efficiently.',
      ].join('\n'),
    },
    clean: {
      story:
        'As a registered user, I want to log in with my username and password so that I can access my account.',
      criteria: [
        'Given valid credentials, when I submit the form, then I am redirected to the inventory page within 2 seconds.',
        "Given an empty password field, when I submit, then a 'Password is required' error is displayed.",
        "Given an invalid username or password, when I submit, then a generic 'credentials do not match' error is shown and no session is created.",
        'Given a locked-out account, when I submit valid credentials, then a lockout error is displayed.',
      ].join('\n'),
    },
  };

  const lang = document.documentElement.lang === 'es' ? 'es' : 'en';
  const copy = demoCopy(lang);

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const storyEl = $<HTMLTextAreaElement>('story');
  const criteriaEl = $<HTMLTextAreaElement>('criteria');
  const scoreEl = $('reqcheck-score');
  const labelEl = $('reqcheck-score-label');
  const meterEl = $('reqcheck-meter');
  const summaryEl = $('reqcheck-summary');
  const findingsEl = $('reqcheck-findings');

  function findingCard(f: Finding): HTMLLIElement {
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text: string) => {
      const node = document.createElement(tag);
      node.className = className;
      node.textContent = text;
      return node;
    };
    const li = el('li', C.item, '');
    const pill = el('span', C.pill, copy.severity[f.severity]);
    pill.style.color = SEVERITY_COLOR[f.severity];
    pill.style.background = tint(SEVERITY_COLOR[f.severity]);

    const body = el('div', C.body, '');
    body.append(el('p', C.category, f.category), el('p', C.message, f.message));
    if (f.criterion) body.append(el('p', C.criterion, `"${f.criterion}"`));

    li.append(pill, body);
    return li;
  }

  function render(): void {
    // Nothing typed yet: there is no requirement to score.
    if (storyEl.value.trim() === '' && criteriaEl.value.trim() === '') {
      scoreEl.textContent = '--';
      scoreEl.style.color = 'var(--color-low)';
      labelEl.textContent = '';
      meterEl.style.width = '0%';
      summaryEl.textContent = copy.empty;
      findingsEl.replaceChildren();
      return;
    }

    const { findings, clarityScore } = analyze(storyEl.value, criteriaEl.value);
    const tone = toneFor(clarityScore, lang);

    scoreEl.textContent = String(clarityScore);
    scoreEl.style.color = tone.color;
    labelEl.textContent = tone.label;
    labelEl.style.color = tone.color;
    labelEl.style.background = tint(tone.color);
    meterEl.style.width = `${clarityScore}%`;
    meterEl.style.backgroundColor = tone.color;

    findingsEl.replaceChildren();

    if (findings.length === 0) {
      summaryEl.textContent = copy.noIssues;
      return;
    }

    summaryEl.textContent = copy.findings(findings.length);
    for (const f of findings) findingsEl.append(findingCard(f));
  }

  let timer: ReturnType<typeof setTimeout>;
  const debouncedRender = () => {
    clearTimeout(timer);
    timer = setTimeout(render, 250);
  };

  storyEl.addEventListener('input', debouncedRender);
  criteriaEl.addEventListener('input', debouncedRender);

  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-example]')) {
    btn.addEventListener('click', () => {
      const key = btn.dataset.example;
      if (key === 'clear') {
        storyEl.value = '';
        criteriaEl.value = '';
      } else if (key === 'flawed' || key === 'clean') {
        storyEl.value = EXAMPLES[key].story;
        criteriaEl.value = EXAMPLES[key].criteria;
      }
      render();
    });
  }

  // The initial example is already analysed in the server-rendered HTML.
</script>
