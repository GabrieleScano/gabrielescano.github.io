---
import { getLang, useTranslations, localeBase } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const base = localeBase(lang);
const year = new Date().getFullYear();
---

<footer id="contact" class="border-t border-line bg-surface">
  <div
    class="mx-auto flex max-w-5xl flex-col gap-3 px-[var(--spacing-gutter)] pb-3 pt-5 text-xs text-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <ul class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <li>
        <a href="mailto:gabrielescano.bcn@gmail.com" class="font-medium text-ink transition-colors hover:text-accent"
          >gabrielescano.bcn@gmail.com</a
        >
      </li>
      <li>
        <a
          href="https://linkedin.com/in/gabrielescano"
          target="_blank"
          rel="me noopener"
          class="font-medium text-ink transition-colors hover:text-accent">LinkedIn</a
        >
      </li>
      <li>
        <a
          href="https://github.com/GabrieleScano"
          target="_blank"
          rel="me noopener"
          class="font-medium text-ink transition-colors hover:text-accent">GitHub</a
        >
      </li>
    </ul>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <a href={`${base}/privacy`} class="transition-colors hover:text-ink">{t('footer.privacy')}</a>
      <button
        id="cookie-preferences-link"
        type="button"
        class="transition-colors hover:text-ink"
      >
        {t('footer.cookies')}
      </button>
    </div>
  </div>
  <!-- Colophon: copyright and a quiet sign-off on their own line, below the links. -->
  <div
    class="mx-auto flex max-w-5xl flex-col gap-1.5 px-[var(--spacing-gutter)] pb-5 text-[11px] text-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} Gabriele Scano</p>
    <p class="flex items-center gap-1.5 font-mono">
      <svg class="h-3 w-3 shrink-0 text-accent" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M13.5 4.5 6.5 11.5 3 8"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      {t('footer.built')}
    </p>
  </div>
</footer>
