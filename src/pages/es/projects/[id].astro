---
import { getCollection } from 'astro:content';
import ProjectDetail from '../../../views/ProjectDetail.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ id }) => id.startsWith('es/'));
  return projects.map((project) => ({
    params: { id: project.id.split('/').slice(1).join('/') },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<ProjectDetail project={project} />
