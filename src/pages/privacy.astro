---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lastUpdated = 'September 2026';
---

<BaseLayout
  title="Privacy Policy — Gabriele Scano"
  description="How this site uses Google Analytics and cookies, and how to opt out."
>
  <Header />

  <main id="main">
    <div class="mx-auto max-w-3xl px-[var(--spacing-gutter)] py-16 sm:py-20">
      <p class="font-mono text-sm text-muted">Last updated: {lastUpdated}</p>
      <h1
        class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl"
      >
        Privacy Policy
      </h1>

      <div class="prose prose-neutral mt-10 max-w-none">
        <h2>What this site collects</h2>
        <p>
          This is a personal portfolio site. It doesn't have user accounts,
          doesn't sell anything, and doesn't collect personal data through
          forms. The only data collection in place is <strong
            >Google Analytics 4</strong
          >, used to understand how many people visit the site and which pages
          they find useful.
        </p>

        <h2>Cookies &amp; consent</h2>
        <p>
          On your first visit you'll see a banner asking whether you accept
          analytics cookies:
        </p>
        <ul>
          <li>
            <strong>Accept</strong> — Google Analytics is allowed to store an
            anonymized, cookie-based identifier in your browser so repeat visits
            can be recognized in aggregate statistics.
          </li>
          <li>
            <strong>Reject</strong> — no analytics cookies are stored. Google's
            <a
              href="https://support.google.com/analytics/answer/9976101"
              target="_blank"
              rel="noopener"
            >
              Consent Mode
            </a>
             keeps analytics storage blocked and only cookieless, aggregated pings
            may be sent.
          </li>
        </ul>
        <p>
          Your choice is stored in your browser's <code>localStorage</code> (not
          a cookie itself) so you aren't asked again. You can change your mind at
          any time using the <strong>"Cookie preferences"</strong> link in the footer.
        </p>

        <h2>IP anonymization</h2>
        <p>
          Google Analytics on this site is configured with IP anonymization, so
          your full IP address is never stored.
        </p>

        <h2>Third parties</h2>
        <p>
          Analytics data is processed by Google, under Google's own <a
            href="https://policies.google.com/privacy"
            target="_blank"
            rel="noopener"
          >
            Privacy Policy
          </a>. No data is shared with any other third party.
        </p>

        <h2>Your choices</h2>
        <p>
          You can reject or withdraw analytics consent at any time from the
          footer link, or block Google Analytics entirely using your browser's
          cookie settings or an extension such as Google's own <a
            href="https://tools.google.com/dlpage/gaoptout"
            target="_blank"
            rel="noopener"
          >
            Analytics opt-out add-on
          </a>.
        </p>

        <h2>Contact</h2>
        <p>
          Questions about this policy? Reach out at <a
            href="mailto:gabrielescano.bcn@gmail.com"
          >
            gabrielescano.bcn@gmail.com
          </a>.
        </p>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
