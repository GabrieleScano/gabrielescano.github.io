---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactMenu from '../components/ContactMenu.astro';
import { getLang, useTranslations, localeBase } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const base = localeBase(lang);

const projects = (await getCollection('projects', ({ id }) => id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
const slug = (id: string) => id.split('/').slice(1).join('/');

const skills =
  lang === 'es'
    ? [
        'Playwright',
        'TypeScript',
        'Page Object Model',
        'Testing de API y de contrato',
        'Testing de rendimiento (K6)',
        'Testing de accesibilidad',
        'Testing cross-browser',
        'Testing asistido por IA',
        'GitHub Actions',
        'Jira',
        'Análisis funcional',
        'Triage de bugs',
        'Agile / Scrum / Kanban',
      ]
    : [
        'Playwright',
        'TypeScript',
        'Page Object Model',
        'API & contract testing',
        'Performance testing (K6)',
        'Accessibility testing',
        'Cross-browser testing',
        'AI-assisted testing',
        'GitHub Actions',
        'Jira',
        'Functional analysis',
        'Bug triage',
        'Agile / Scrum / Kanban',
      ];

const spokenLanguages = [t('about.lang.1'), t('about.lang.2'), t('about.lang.3'), t('about.lang.4')];

const timeline = [
  { period: '2023 — 2026', role: t('about.timeline.1') },
  { period: '2018 — 2022', role: t('about.timeline.2') },
  { period: '2014 — 2018', role: t('about.timeline.3') },
  { period: '2005 — 2011', role: t('about.timeline.4') },
];
---

<BaseLayout title={t('home.page.title')} description={t('home.page.description')}>
  <Header />

  <main id="main">
    <!-- Hero: single column over a halftone close-up of my face. On desktop it
         fills the viewport and slides under the translucent sticky header (69px),
         so the top of the photo shows through it. -->
    <section
      data-hero-under-header
      class="relative isolate lg:-mt-[69px] lg:flex lg:min-h-svh lg:items-center lg:pt-[69px]">
      <div class="hero-photo" aria-hidden="true">
        <div class="hero-photo-img">
          <div class="hero-photo-src"></div>
        </div>
      </div>
      <div class="mx-auto w-full max-w-6xl px-[var(--spacing-gutter)] pb-14 pt-12 sm:pt-16 lg:py-16">
        <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 font-mono text-xs text-muted">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
          </span>
          {t('hero.location')}
        </p>

        <h1
          class="mt-6 font-display text-4xl font-semibold leading-[1.05] tracking-tight text-ink sm:text-6xl lg:text-7xl"
        >
          {t('hero.title.line1')}<br class="lg:hidden" />{' '}
          <span class="text-muted">{t('hero.title.line2')}</span>
        </h1>

        <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
          {t('hero.lead.pre')}{t('hero.lead.em') && <em class="text-ink not-italic">{t('hero.lead.em')}</em>}{t('hero.lead.post')}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#projects"
            class="rounded-full bg-ink px-6 py-2.5 text-sm font-medium text-bg transition-opacity hover:opacity-90"
          >
            {t('hero.cta.projects')}
          </a>
          <ContactMenu />
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section
      id="projects"
      class="mx-auto max-w-6xl scroll-mt-20 px-[var(--spacing-gutter)] py-12"
    >
      <div class="flex items-end justify-between gap-4">
        <h2 class="font-display text-3xl font-semibold tracking-tight text-ink">
          {t('projects.heading')}
        </h2>
        <p class="hidden max-w-xs text-right text-sm text-muted sm:block">
          {t('projects.subheading')}
        </p>
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {
          projects.map((project, i) => (
            <ProjectCard
              index={i + 1}
              title={project.data.title}
              tagline={project.data.tagline}
              href={`${base}/projects/${slug(project.id)}/`}
              repo={project.data.repo}
              stack={project.data.stack}
              metrics={project.data.metrics}
            />
          ))
        }
      </div>
    </section>

    <!-- About + approach, side by side -->
    <section
      id="about"
      class="mx-auto max-w-6xl scroll-mt-20 px-[var(--spacing-gutter)] py-12"
    >
      <div class="grid gap-12 lg:grid-cols-[1.15fr_1fr]">
        <div>
          <div class="flex items-center gap-4">
            <img
              src="/gabriele-scano.jpg"
              alt="Gabriele Scano"
              width="64"
              height="64"
              loading="lazy"
              class="h-14 w-14 rounded-2xl border border-line object-cover sm:h-16 sm:w-16"
            />
            <div>
              <h2 class="font-display text-3xl font-semibold tracking-tight text-ink">
                {t('about.heading')}
              </h2>
              <p class="text-sm text-muted">{t('about.subheading')}</p>
            </div>
          </div>

          <div class="mt-6 space-y-4 text-[15px] leading-relaxed text-ink/80">
            <p>{t('about.p1')}</p>
            <p>{t('about.p2')}</p>
            <p>{t('about.p3')}</p>
            <p>{t('about.p4')}</p>
            <!-- Closes the story with where I'm headed. -->
            <p class="font-medium text-ink">{t('about.open')}</p>
          </div>

          <ol class="mt-8 space-y-3 border-t border-line pt-6">
            {
              timeline.map((item) => (
                <li class="flex flex-col gap-1 sm:flex-row sm:gap-4">
                  <span class="shrink-0 font-mono text-xs text-accent sm:w-24">
                    {item.period}
                  </span>
                  <span class="text-sm text-muted">{item.role}</span>
                </li>
              ))
            }
          </ol>

          <div class="mt-6 flex flex-col gap-1 border-t border-line pt-6 sm:flex-row sm:gap-4">
            <h3 class="shrink-0 font-mono text-xs text-accent sm:w-24">{t('about.languages')}</h3>
            <p class="text-sm text-muted">{spokenLanguages.join(' · ')}</p>
          </div>
        </div>

        <div id="approach" class="scroll-mt-20 rounded-2xl border border-line bg-surface p-6 sm:p-8">
          <h2 class="font-display text-2xl font-semibold tracking-tight text-ink">
            {t('approach.heading')}
          </h2>
          <dl class="mt-6 space-y-5">
            <div>
              <dt class="font-mono text-sm text-accent">{t('approach.shiftleft.title')}</dt>
              <dd class="mt-1.5 text-sm leading-relaxed text-ink/80">{t('approach.shiftleft.body')}</dd>
            </div>
            <div>
              <dt class="font-mono text-sm text-accent">{t('approach.automation.title')}</dt>
              <dd class="mt-1.5 text-sm leading-relaxed text-ink/80">{t('approach.automation.body')}</dd>
            </div>
            <div>
              <dt class="font-mono text-sm text-accent">{t('approach.ai.title')}</dt>
              <dd class="mt-1.5 text-sm leading-relaxed text-ink/80">{t('approach.ai.body')}</dd>
            </div>
          </dl>

          <ul class="mt-7 flex flex-wrap gap-2 border-t border-line pt-6">
            {
              skills.map((skill) => (
                <li class="rounded-full border border-line px-3 py-1 font-mono text-xs text-muted">
                  {skill}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
